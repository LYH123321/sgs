#!/bin/bash
# gradlew — Gradle startup script for Android SGS
# Usage: ./gradlew assembleRelease  (or assembleDebug)
# Requires: JDK 17+, Android SDK (ANDROID_HOME or local.properties)

# Resolve script location
PRG="$0"
while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  case $link in
    /*) PRG="$link" ;;
    *) PRG=$(dirname "$PRG")/"$link" ;;
  esac
done
APP_HOME=$(cd "$(dirname "$PRG")" && pwd)

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Set JAVA_HOME if not set
if [ -z "$JAVA_HOME" ]; then
  # Try common locations
  if [ -x /usr/lib/jvm/java-17-openjdk/bin/java ]; then
    export JAVA_HOME=/usr/lib/jvm/java-17-openjdk
  elif [ -x /usr/lib/jvm/java-21-openjdk/bin/java ]; then
    export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
  fi
fi

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ]; then
  echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
  echo "Please set the JAVA_HOME variable to your JDK installation directory."
  exit 1
fi

# Set ANDROID_HOME if not set
if [ -z "$ANDROID_HOME" ]; then
  if [ -d "$HOME/Android/Sdk" ]; then
    export ANDROID_HOME="$HOME/Android/Sdk"
  elif [ -d "$HOME/Library/Android/sdk" ]; then
    export ANDROID_HOME="$HOME/Library/Android/sdk"
  elif [ -d "$ANDROID_SDK_ROOT" ]; then
    export ANDROID_HOME="$ANDROID_SDK_ROOT"
  fi
fi

# JVM args
DEFAULT_JVM_OPTS='"-Xmx2048m" "-Xms512m"'

exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
