# AI 接口本地配置模板
# 复制为 ai.env（同目录）并填好即可，之后双击 run-game.bat 无需在终端敲环境变量。
# 已 export 的环境变量优先于本文件；本文件不要写引号，等号两边不要加空格。
# 以 # 开头的行是注释。密钥在 ai.env 里，请勿提交（已在 .gitignore 中）。

# ── 直连模式（最简单，密钥会进游戏进程）──────────────────────
SGS_AI_URL=https://llm.example.com/v1/responses
SGS_AI_KEY=sk-...
SGS_AI_MODEL=你的模型名
SGS_AI_REASONING=none

# ── 代理模式（推荐：密钥只进 ai_proxy.py，不进游戏）────────────
# 取消下面注释并注释掉上面的直连三行；配在 ai.env 后，跑代理的
# 终端也不需要再 export，直接 tools\ai_proxy.py 即可：
# SGS_AI_TRANSPORT=proxy
# SGS_AI_PROXY=http://127.0.0.1:8899

# ── 其他可选项（默认值见 AI启动指南.md）──────────────────────
# SGS_AI_PROTOCOL=responses
# SGS_AI_THINKING=off

# ── Jev 决策模型（TypeSafe System One，与上面的对话 LLM 二选一）──
# SGS_AI_ENGINE 设为 jev 后走决策模型路线（state+questions，无文本生成），
# 上面的 SGS_AI_URL/KEY/MODEL/REASONING/THINKING 全部忽略。
# 密钥在 https://console.typesafe.ai/keys 获取。
# SGS_AI_ENGINE=jev
# SGS_JEV_KEY=ts-...
# SGS_JEV_URL=https://api.typesafe.ai/v1/systemone
# SGS_JEV_MODEL=jev-latest
# SGS_JEV_MIN_CONFIDENCE=0.35

# ── 混合模式：jev 管高频短决策（响应/技能/弃牌/选牌），llm 管长推理 ──
# 同时配置上面两段（SGS_AI_* 对话 + SGS_JEV_* 决策）后启用：
# SGS_AI_ENGINE=mixed
# 两边都可以走代理（SGS_AI_TRANSPORT=proxy 时 jev 密钥也配在代理侧）

# ── 联机服务端：空座交给 LLM（tools\serve.bat 同样读 ai.env）────
# SGS_NET_AI=1
